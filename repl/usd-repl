def _stdin_line(more):
    line = sys.stdin.readline()
    if not line:
        raise EOFError
    return line.rstrip('\n')


def main():
    parser = argparse.ArgumentParser(
        prog='usd-repl', description='An OpenUSD C++ REPL on top of clang-repl.',
        epilog='Inside the REPL, %help lists the commands.')
    parser.add_argument('files', nargs='*', type=Path,
                        help='lesson sources (.cpp) or saved sessions (.repl) to run first')
    parser.add_argument('--batch', action='store_true',
                        help='run the files and exit; exit status 1 if any input failed')
    parser.add_argument('--emit', action='store_true',
                        help='print the inputs the files turn into, without running them')
    parser.add_argument('--cwd', type=Path,
                        help='working directory (default: the lesson\'s build/output/<target>)')
    parser.add_argument('--build-dir', type=Path, default=REPO / 'build',
                        help='configured CMake build to take flags and USD_ROOT from')
    parser.add_argument('--clang-repl', help='clang-repl binary (default: $USD_REPL_CLANG_REPL, '
                                             'then the newest clang-repl on PATH)')
    parser.add_argument('--no-color', action='store_true',
                        help='plain text, no colours (NO_COLOR=1 does the same)')
    args = parser.parse_args()

    for f in args.files:
        if not f.is_file():
            die(f'no such file: {f}')
    if args.emit:
        for f in args.files:
            for text in inputs_from_file(f):
                print(text)
        return 0

    interactive = not args.batch and sys.stdin.isatty()
    colour = sys.stdout.isatty() and not args.no_color and not os.environ.get('NO_COLOR')
    painter = Painter.create() if colour else None

    build_dir = args.build_dir.resolve()
    cfg = Config(build_dir, args.clang_repl, colour=painter is not None)
    if args.cwd:
        cwd = args.cwd.resolve()
    else:
        cwd = next((w for w in (lesson_workdir(f, build_dir) for f in args.files) if w), None) or Path.cwd()
    if not cwd.is_dir():
        die(f'no such directory: {cwd}')

    if interactive:
        hint = ''
        if sys.stdout.isatty() and not importlib.util.find_spec('prompt_toolkit'):
            hint = 'For highlighting as you type: sudo apt install python3-prompt-toolkit\n'
        _write_out(f'usd-repl: {cfg.describe()}, in {cwd}\n{hint}'
                   f'%help lists the commands; Ctrl-D quits. Starting clang-repl...\n')
    try:
        session = Session(cfg, cwd, batch=not interactive, painter=painter)
    except KeyboardInterrupt:
        _write_out('\n')
        return 130
    atexit.register(session.close)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    signal.signal(signal.SIGHUP, lambda *_: sys.exit(1))

    try:
        for f in args.files:
            if not session.run_inputs(inputs_from_file(f), echo=True):
                break
        if interactive:
            interact(session, colour=painter is not None)
        elif not args.batch and not args.files:
            # Input piped in: run it like a file.
            reader = BlockReader(_stdin_line)
            inputs = []
            while True:
                try:
                    inputs.append(reader.read())
                except EOFError:
                    break
            session.run_inputs(inputs, echo=True)
    except KeyboardInterrupt:
        _write_out('\n')
        return 130
    return 1 if session.failures and not interactive else 0


if __name__ == '__main__':
    sys.exit(main())
