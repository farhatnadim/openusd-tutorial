#!/usr/bin/env python3
"""usd-repl: the lessons in cpp-repl's usd profile.

    repl/usd-repl                                     an empty session
    repl/usd-repl nvidia_tutorials/08_xform/main.cpp  run a lesson, keep the prompt
    repl/usd-repl --batch FILE...                     run files and exit
    repl/usd-repl --emit FILE...                      print the inputs a file becomes

cpp-repl (github.com/farhatnadim/cpp_repl) is the REPL; cmake --preset default
fetches it into build/_deps. This launcher adds the repository's defaults and
hands the rest of the command line over as it is, cpp-repl's options and
compiler flags included (repl/usd-repl --help):

    -p usd                       OpenUSD loaded, using namespace pxr, show(), tree()
    --build-dir build            the compile flags and USD_ROOT of the configured build
    --cwd build/output/<target>  for a lesson's source, with its _assets/ staged,
                                 as under ctest

cpp-repl is $CPP_REPL, then the one the build fetched, then the one on PATH.
USD_REPL_CLANG_REPL still names the clang-repl to run; cpp-repl's own name
for it is CPP_REPL_CLANG_REPL.
"""

import os
import re
import shutil
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# cpp-repl's options and compiler flags that take the next argument as their
# value, so that the value is not taken for a file to run.
WITH_VALUE = {'-p', '--profile', '-c', '--config', '--compile-commands', '--build-dir', '--lib', '-l', '-L',
              '--clang-repl', '--timeout', '--cwd', '--diagnostics', '--serve', '--connect', '--image',
              '--mount', '-I', '-isystem', '-iquote', '-idirafter', '-D', '-U', '-include', '-isysroot',
              '--sysroot'}
# With these, cpp-repl starts no session, so no lesson directory is prepared...
NO_SESSION = {'-h', '--help', '--version', '--emit', '--cflags', '--libs', '--connect'}
# ...and with these it reads no build either.
NO_BUILD = {'-h', '--help', '--version', '--emit'}


def die(message):
    sys.stderr.write(f'usd-repl: {message}\n')
    sys.exit(2)


def option_value(argv, name):
    """The value of `name VALUE` or `name=VALUE` in argv; None when absent."""
    for i, a in enumerate(argv):
        if a == name and i + 1 < len(argv):
            return argv[i + 1]
        if a.startswith(name + '='):
            return a[len(name) + 1:]
    return None


def files_in(argv):
    """The files argv names: whatever is neither an option nor its value."""
    files, i = [], 0
    while i < len(argv):
        a = argv[i]
        if a == '--':
            files += argv[i + 1:]
            break
        if a in WITH_VALUE:
            i += 1
        elif not a.startswith('-'):
            files.append(a)
        i += 1
    return [Path(f) for f in files]


def find_cpp_repl(build_dir):
    """$CPP_REPL, then the cpp-repl the build fetched, then the one on PATH."""
    explicit = os.environ.get('CPP_REPL')
    if explicit:
        if not Path(explicit).is_file():
            die(f'$CPP_REPL is {explicit}, which is not a file')
        return Path(explicit)
    cache = build_dir / 'CMakeCache.txt'
    if cache.is_file():
        m = re.search(r'^CPP_REPL:\w+=(.+)$', cache.read_text(errors='replace'), re.M)
        if m and Path(m.group(1)).is_file():
            return Path(m.group(1))
    found = shutil.which('cpp-repl')
    if found:
        return Path(found)
    die('no cpp-repl: configure the build, which fetches it (cmake --preset default), or set CPP_REPL')


def lesson_workdir(path, build_dir):
    """build/output/<target> for a source inside a lesson, with the lesson's
    _assets staged into it as the CMake build does; None outside a lesson.
    The target is the add_usd_example whose sources share the file's stem."""
    path = path.resolve()
    for d in path.parents:
        if d == REPO or REPO not in d.parents:
            return None
        cmakelists = d / 'CMakeLists.txt'
        if not cmakelists.is_file():
            continue
        calls = re.findall(r'^\s*add_usd_example\s*\(\s*([\w-]+)(.*)$', cmakelists.read_text(), re.M)
        if not calls:
            continue
        target = next((name for name, rest in calls
                       if any(Path(w).stem == path.stem for w in rest.split())), calls[0][0])
        workdir = build_dir / 'output' / target
        (workdir / '_assets').mkdir(parents=True, exist_ok=True)
        if (d / '_assets').is_dir():
            shutil.copytree(d / '_assets', workdir / '_assets', dirs_exist_ok=True)
        return workdir
    return None


def main():
    argv = sys.argv[1:]
    if sys.version_info < (3, 11):
        die('cpp-repl needs Python 3.11 or newer')
    given = option_value(argv, '--build-dir') or option_value(argv, '--compile-commands')
    build_dir = Path(given).resolve() if given else REPO / 'build'
    if build_dir.is_file():   # --compile-commands names the file itself
        build_dir = build_dir.parent
    defaults = ['-p', 'usd']
    if not given and not (NO_BUILD & set(argv)):
        if not (build_dir / 'compile_commands.json').is_file():
            die(f'no configured build in {build_dir}: cmake --preset default')
        defaults += ['--build-dir', str(build_dir)]
    # A build that is not there is cpp-repl's to report.
    if build_dir.is_dir() and not (NO_SESSION & set(argv)) and option_value(argv, '--cwd') is None:
        workdir = next((w for w in (lesson_workdir(f, build_dir) for f in files_in(argv)) if w), None)
        if workdir:
            defaults += ['--cwd', str(workdir)]
    if 'CPP_REPL_CLANG_REPL' not in os.environ and os.environ.get('USD_REPL_CLANG_REPL'):
        os.environ['CPP_REPL_CLANG_REPL'] = os.environ['USD_REPL_CLANG_REPL']
    cpp_repl = find_cpp_repl(build_dir)
    os.execv(sys.executable, [sys.executable, str(cpp_repl), *defaults, *argv])


if __name__ == '__main__':
    main()
