# Configuration: everything comes from the CMake build, so the REPL compiles
# exactly what the lessons compile.
# ---------------------------------------------------------------------------

def die(message):
    sys.exit(f'usd-repl: {message}')


def compile_flags(entries):
    """-std, -D, -U, -I, -isystem and -Wno-* from a compile_commands.json entry."""
    entry = entries[0]
    args = entry.get('arguments') or shlex.split(entry['command'])
    flags, i = [], 1
    while i < len(args):
        a = args[i]
        if a in ('-o', '-MF', '-MT', '-MQ', '-include'):
            i += 2
            continue
        if a in ('-isystem', '-I', '-D', '-U') and i + 1 < len(args):
            flags += [a, args[i + 1]]
            i += 2
            continue
        if a.startswith(('-std=', '-D', '-U', '-I', '-isystem', '-Wno-')):
            flags.append(a)
        i += 1
    return flags


def find_clang_repl(explicit):
    for candidate in (explicit, os.environ.get('USD_REPL_CLANG_REPL')):
        if candidate:
            return candidate
    found = shutil.which('clang-repl')
    if found:
        return found
    best = None
    for directory in os.environ.get('PATH', '').split(os.pathsep):
        d = Path(directory)
        if not d.is_dir():
            continue
        for p in d.glob('clang-repl-*'):
            m = re.fullmatch(r'clang-repl-(\d+)', p.name)
            if m and os.access(p, os.X_OK) and (best is None or int(m.group(1)) > best[0]):
                best = (int(m.group(1)), str(p))
    if best:
        return best[1]
    die('no clang-repl found: install clang-tools-18, or set USD_REPL_CLANG_REPL')


class Config:
    def __init__(self, build_dir, clang_repl, colour=False):
        cache, commands = build_dir / 'CMakeCache.txt', build_dir / 'compile_commands.json'
        if not cache.is_file() or not commands.is_file():
            die(f'{build_dir} is not a configured build; run: cmake --preset default')
        m = re.search(r'^USD_ROOT:PATH=(.*)$', cache.read_text(), re.M)
        if not m:
            die(f'no USD_ROOT in {cache}')
        self.usd_root = Path(m.group(1).strip())
        self.flags = compile_flags(json.loads(commands.read_text()))
        self.clang_repl = find_clang_repl(clang_repl)
        self.argv = ([self.clang_repl] + ['--Xcc=' + f for f in self.flags]
                     + ['--Xcc=-include', '--Xcc=' + str(PRELUDE)]
                     + (['--Xcc=-fcolor-diagnostics'] if colour else []))

        # clang-repl keeps its line history in $HOME and USD writes the stack
        # of a fatal error to $TMPDIR; both go under the build tree instead.
        state = build_dir / 'repl'
        for d in ('home', 'tmp'):
            (state / d).mkdir(parents=True, exist_ok=True)
        self.env = dict(os.environ, HOME=str(state / 'home'), TMPDIR=str(state / 'tmp'))
        self.env.pop('LD_PRELOAD', None)
        self.history = state / 'history'
        self.inputs = state / 'inputs'   # inputs that go through a file

        libs = [self.usd_root / 'lib' / f'libusd_{name}.so' for name in LIBS]
        # Core dumps go off before any library loads, so that a crash in a
        # library's static initialiser leaves no apport report either.
        self.prologue = [
            'prctl(PR_SET_DUMPABLE, 0, 0, 0, 0);',   # a crash leaves no apport report
            'setvbuf(stdout, nullptr, _IONBF, 0);',  # keep stdout in step with stderr
        ] + [f'%lib {lib}' for lib in libs if lib.is_file()]

    def describe(self):
        version = '?'
        pxr_h = self.usd_root / 'include' / 'pxr' / 'pxr.h'
        if pxr_h.is_file():
            parts = re.findall(r'#define PXR_(?:MAJOR|MINOR|PATCH)_VERSION (\d+)', pxr_h.read_text())
            version = '.'.join(parts) or version
        return f'OpenUSD {version}, {Path(self.clang_repl).name}'


def lesson_workdir(path, build_dir):
    """build/output/<target> for a source inside a lesson, with the lesson's
    _assets staged into it as the CMake build does; None outside a lesson.
    The target is the add_usd_example whose sources share the file's stem."""
    path = path.resolve()
    for d in path.parents:
        if d == REPO or REPO not in d.parents:
            return None
        cmakelists = d / 'CMakeLists.txt'
        if not cmakelists.is_file():
            continue
        calls = re.findall(r'^\s*add_usd_example\s*\(\s*([\w-]+)(.*)$', cmakelists.read_text(), re.M)
        if not calls:
            continue
        target = next((name for name, rest in calls
                       if any(Path(w).stem == path.stem for w in rest.split())), calls[0][0])
        workdir = build_dir / 'output' / target
        (workdir / '_assets').mkdir(parents=True, exist_ok=True)
        if (d / '_assets').is_dir():
            shutil.copytree(d / '_assets', workdir / '_assets', dirs_exist_ok=True)
        return workdir
    return None


# ---------------------------------------------------------------------------
# Backend: one clang-repl process.
# ---------------------------------------------------------------------------

_PARSE_FAILED = re.compile(r'^error: Parsing failed\.|^fatal error: ', re.M)
_LINK_FAILED = re.compile(r'^JIT session error: |^error: Failed to materialize symbols'
                          r'|^error: Duplicate definition of symbol', re.M)
_ANY_ERROR = re.compile(r'^error: ', re.M)
_NOISE = re.compile(r'In file included from <<< inputs >>>:1:\s*$')
_STUCK = b'too many errors emitted'
_ANSI = re.compile(r'\x1b\[[0-9;?]*[A-Za-z]')


def plain(text):
    """text without colour codes."""
    return _ANSI.sub('', text)


def outcome(output):
    """'ok', 'error' (it did not compile) or 'link' (it compiled but did not
    link, which leaves clang-repl 18 unreliable)."""
    text = plain(output)
    if _LINK_FAILED.search(text):
        return 'link'
    if _PARSE_FAILED.search(text):
        return 'error'
    return 'ok'


class Backend:
    """A clang-repl process fed through its stdin, with stdout and stderr
    merged into one pipe. After each input a %lib of a path that cannot exist
    makes clang-repl print a unique error line, which marks where that input's
    output ends. Unlike a C++ marker it adds nothing to the session."""

    def __init__(self, cfg, cwd):
        self.proc = subprocess.Popen(cfg.argv, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                     stderr=subprocess.STDOUT, cwd=cwd, env=cfg.env,
                                     start_new_session=True)
        self.fd = self.proc.stdout.fileno()
        self.buffer = b''
        self.seq = 0
        self.stuck = False
        try:
            for line in cfg.prologue:
                self._write(line)
            self.ready = self._mark()
        except (BrokenPipeError, OSError):
            self.ready = '__USD_REPL_NEVER__'   # collect() then reports the dead process

    def _write(self, line):
        self.proc.stdin.write(line.encode() + b'\n')
        self.proc.stdin.flush()

    def _mark(self):
        self.seq += 1
        token = f'__USD_REPL_SYNC_{self.seq}__'
        self._write(f'%lib /nonexistent/usd-repl/{token}')
        return token

    def run(self, line, echo=None):
        """Send one input. Returns (output, alive)."""
        try:
            self._write(line)
            token = self._mark()
        except (BrokenPipeError, OSError):
            return '', False
        return self.collect(token, echo)

    def collect(self, token, echo=None):
        """Read up to the marker for token; echo(text) receives whole lines as
        they arrive. Returns (output, alive)."""
        tok, pieces = token.encode(), []

        def emit(data):
            text = ''.join(line for line in data.decode('utf-8', 'replace').splitlines(keepends=True)
                           if not _NOISE.match(plain(line)))
            if text:
                pieces.append(text)
                if echo:
                    echo(text)

        while True:
            idx = self.buffer.find(tok)
            if idx >= 0:
                newline = self.buffer.find(b'\n', idx)
                if newline >= 0:
                    start = self.buffer.rfind(b'error: /nonexistent/usd-repl/', 0, idx)
                    emit(self.buffer[:start if start >= 0 else idx])
                    self.buffer = self.buffer[newline + 1:]
                    return ''.join(pieces), True
            else:
                newline = self.buffer.rfind(b'\n')
                if newline >= 0:
                    emit(self.buffer[:newline + 1])
                    self.buffer = self.buffer[newline + 1:]
            chunk = os.read(self.fd, 65536)
            if not chunk:
                emit(self.buffer)
                self.buffer = b''
                return ''.join(pieces), False
            if _STUCK in chunk:
                # clang-repl 18 can loop forever after this; nothing more will come.
                self.stuck = True
                self.kill()
            self.buffer += chunk

    def kill(self):
        if self.proc.poll() is None:
            try:
                os.killpg(self.proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass

    def close(self):
        if self.proc.poll() is None:
            try:
                self._write('%quit')
                self.proc.wait(timeout=2)
            except (BrokenPipeError, OSError, subprocess.TimeoutExpired):
                self.kill()
        self.proc.wait()

    def how_it_ended(self):
        if self.stuck:
            return 'clang-repl got stuck on that input'
        rc = self.proc.wait()
        if rc < 0:
            try:
                return f'clang-repl crashed ({signal.Signals(-rc).name})'
            except ValueError:
                return f'clang-repl crashed (signal {-rc})'
        return f'clang-repl exited (code {rc})'


# ---------------------------------------------------------------------------
# Colour: usda through Pygments' USD lexer, USD's errors and warnings by
# severity, echoed inputs as C++.
# ---------------------------------------------------------------------------

_USD_DIAGNOSTIC = re.compile(r'(Coding Error|Runtime Error|Fatal Error|FATAL ERROR|Error|Warning|Status):')


class Painter:
    def __init__(self):
        from pygments import highlight
        from pygments.formatters import TerminalFormatter
        from pygments.lexers import get_lexer_by_name
        self._highlight, self._formatter = highlight, TerminalFormatter()
        self._usd, self._cpp = get_lexer_by_name('usd'), get_lexer_by_name('cpp')
        self._usda = None

    @staticmethod
    def create():
        """A Painter, or None without Pygments."""
        try:
            return Painter()
        except ImportError:
            return None

    def feed(self, text):
        """Paint backend output as it arrives. A usda block is held back until
        flush(), so the lexer sees all of it."""
        out = []
        for line in text.splitlines(keepends=True):
            if self._usda is None and plain(line).startswith('#usda '):
                self._usda = []
            if self._usda is not None:
                self._usda.append(line)
                continue
            m = _USD_DIAGNOSTIC.match(line)
            if m:
                colour = {'Warning': '33', 'Status': '36'}.get(m.group(1), '1;31')
                line = f'\x1b[{colour}m{m.group(0)}\x1b[0m{line[m.end():]}'
            out.append(line)
        return ''.join(out)

    def flush(self):
        if self._usda is None:
            return ''
        text, self._usda = ''.join(self._usda), None
        return self._highlight(text, self._usd, self._formatter)

    def code(self, text):
        return self._highlight(text, self._cpp, self._formatter).rstrip('\n')

    @staticmethod
    def note(text):
        return f'\x1b[33m{text}\x1b[0m'

    @staticmethod
    def prompt(text):
        return f'\x1b[1;32m{text}\x1b[0m'


# ---------------------------------------------------------------------------
# Session: the journal and everything typed.
# ---------------------------------------------------------------------------

# text: as typed. sent: the lines clang-repl ran. kind: 'stmt', 'expr' (a bare
# expression with a value), 'void' (a bare void expression), 'pp' or 'lib'.
Entry = namedtuple('Entry', 'text sent kind')

VOID_MARK = '\x1e'   # what repl::print_expr writes after a void expression

_at_line_start = [True]


def _write_out(text):
    if text:
        sys.stdout.write(text)
        sys.stdout.flush()
        _at_line_start[0] = plain(text).endswith('\n')


def _end_line():
    if not _at_line_start[0]:
        _write_out('\n')


class Session:
    def __init__(self, cfg, cwd, batch, painter=None):
        self.cfg, self.cwd, self.batch, self.painter = cfg, cwd, batch, painter
        self.journal = []
        self.failures = 0
        self.spare = None
        self.files = 0
        self.inputs = cfg.inputs / f'{os.getpid()}-{time.time_ns()}'
        self.backend = self._start()
        if not batch:
            self.spare = Backend(cfg, cwd)

    def _start(self, backend=None):
        """A backend that has loaded the libraries: the one given if it got
        there, else a new one."""
        output = ''
        for candidate in (backend, None):
            b = candidate or Backend(self.cfg, self.cwd)
            output, alive = b.collect(b.ready)
            if alive and outcome(output) == 'ok' and not _ANY_ERROR.search(plain(output)):
                return b
            b.kill()
        die('clang-repl failed to start:\n' + output)

    def close(self):
        if self.spare:
            self.spare.kill()   # nothing in it to keep
            self.spare.proc.wait()
        self.backend.close()
        shutil.rmtree(self.inputs, ignore_errors=True)

    def _note(self, text):
        _end_line()
        _write_out((self.painter.note(text) if self.painter else text) + '\n')

    # -- restoring --------------------------------------------------------

    def restore(self, journal, reason):
        """Replace the backend with a fresh one that has replayed journal."""
        self.backend.kill()
        previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
        try:
            backend = self._start(self.spare)
            self.spare = None
            kept = []
            for entry in journal:
                ok = True
                for line in entry.sent:
                    output, alive = backend.run(line)
                    if not alive or outcome(output) != 'ok':
                        ok = False
                        break
                if not ok:
                    self._note(f'replay stopped at: {entry.text.splitlines()[0]}')
                    if not alive:
                        backend = self._start()
                        for e in kept:
                            for line in e.sent:
                                backend.run(line)
                    break
                kept.append(entry)
            self.backend, self.journal = backend, kept
            if not self.batch:
                self.spare = Backend(self.cfg, self.cwd)
        finally:
            signal.signal(signal.SIGINT, previous)
        self._note(f'[{reason}: restored {len(kept)} input{"s" if len(kept) != 1 else ""}]')

    # -- running ----------------------------------------------------------

    def _show(self, text):
        """Write backend output, painted when colour is on."""
        _write_out(self.painter.feed(text) if self.painter else text)

    def _show_end(self):
        if self.painter:
            _write_out(self.painter.flush())
        _end_line()

    def _send(self, line, echo=True):
        """Run one line. Returns (output, result), result being 'ok', 'error',
        'link', 'dead' or 'interrupted'."""
        try:
            output, alive = self.backend.run(line, echo=self._show if echo else None)
        except KeyboardInterrupt:
            self.backend.kill()
            self._show_end()
            return '', 'interrupted'
        if echo:
            self._show_end()
        if not alive:
            return output, 'dead'
        return output, outcome(output)

    def _after(self, text, sent, output, result, kind='stmt'):
        """Journal or recover after an input ran. Returns True if it worked."""
        if result == 'ok':
            self.journal.append(Entry(text, sent, kind))
            return True
        self.failures += 1
        if self.batch:
            if result == 'dead':
                self._note(f'[{self.backend.how_it_ended()}]')
            return result not in ('dead', 'interrupted')
        if result == 'dead':
            self.restore(self.journal, self.backend.how_it_ended())
        elif result == 'interrupted':
            self.restore(self.journal, 'interrupted')
        elif result == 'link':
            self.restore(self.journal, 'that input failed to link')
        return False

    def _file(self, text):
        """An #include of a new file holding text, for an input whose
        preprocessor lines must keep their own lines."""
        self.inputs.mkdir(parents=True, exist_ok=True)
        self.files += 1
        path = self.inputs / f'input_{self.files}.h'
        path.write_text(text + '\n')
        return f'#include "{path}"'

    def run_input(self, text):
        """Run one complete input. Returns False when the session should stop."""
        stripped = text.strip()
        if not stripped:
            return True
        if stripped.startswith('%'):
            return self.command(stripped)
        parts = split_directives(text)
        if len(parts) > 1:   # a pasted block of #include lines and code
            return all(self.run_input(part) for _, part in parts)
        split = trailing_expression(text)
        if split:
            return all(self.run_input(part) for part in split)
        send = transform(text)
        if send.kind == 'empty':
            return True
        line = self._file(send.text) if send.file else send.text
        kind = send.kind
        if kind == 'expr':
            printed = 'repl::print_expr([]() -> decltype(auto) { return (%s); });' % line
            output, result = self._send(printed, echo=False)
            if result != 'error':
                if VOID_MARK in output:
                    kind, output = 'void', output.replace(VOID_MARK, '')
                self._show(output)
                self._show_end()
                return self._after(text, [printed], output, result, kind) or not self.batch
            line, kind = line + ';', 'stmt'   # not something print_expr takes
        output, result = self._send(line)
        return self._after(text, [line], output, result, kind) or not self.batch

    def run_inputs(self, inputs, echo):
        for text in inputs:
            if echo:
                self._echo_input(text)
            if not self.run_input(text):
                return False
        return True

    def _echo_input(self, text):
        prompt, more = PROMPT, MORE
        if self.painter:
            text = self.painter.code(text)
            prompt, more = self.painter.prompt(PROMPT), self.painter.prompt(MORE)
        first, *rest = text.split('\n')
        _end_line()
        _write_out(prompt + first + '\n' + ''.join(more + r + '\n' for r in rest))

    # -- saving -----------------------------------------------------------

    def as_cpp(self, path):
        """The journal as a C++ program: directives and definitions at file
        scope, the rest inside main(), bare expressions through show()."""
        includes, libs, definitions, body = [], [], [], []
        for entry in self.journal:
            text = _unsplice(entry.text).strip()
            tokens, _ = lex(text)
            if entry.kind == 'pp':
                if not _PRELUDE_INCLUDE.match(text):
                    includes.append(text)
            elif entry.kind == 'lib':
                libs.append(text.split(None, 1)[-1])
            elif entry.kind == 'expr':
                body.append(f'show({join(tokens)});')
            elif entry.kind == 'void':
                body.append(f'{join(tokens)};')
            elif is_definition(text):
                definitions.append(text)
            else:
                stmts = split_statements(tokens)
                if stmts and _open_end(*stmts[-1]):
                    body.append(join(tokens) + ';')
                else:
                    body.append(text)
        # Relative inside the repository, so the file can move with it.
        folder = path.resolve().parent
        prelude = os.path.relpath(PRELUDE, folder) if folder == REPO or REPO in folder.parents else PRELUDE
        out = [f'// Saved from a repl/usd-repl session on {date.today()}. It builds like a',
               '// lesson, and repl/usd-repl runs it again.',
               '//',
               "// usd_repl.h is the REPL's prelude: the USD headers, using namespace pxr,",
               '// show() and tree().',
               f'#include "{prelude}"']
        out += includes
        if libs:
            out += ['', '// The session also loaded these libraries; link them as well:']
            out += [f'//   {lib}' for lib in libs]
        for definition in definitions:
            out += ['', definition]
        out += ['', 'int main()', '{']
        for stmt in body:
            out += [('  ' + line) if line.strip() else '' for line in stmt.split('\n')]
        out += ['  return 0;', '}', '']
        return '\n'.join(out)

    # -- commands ---------------------------------------------------------

    def command(self, text):
        name, _, arg = text.partition(' ')
        arg = arg.strip()
        if name == '%help':
            _write_out(HELP)
        elif name == '%quit':
            raise SystemExit(0 if not self.batch or not self.failures else 1)
        elif name == '%undo':
            if not self.journal:
                _write_out('nothing to undo\n')
            else:
                _write_out(f'undo: {self.journal[-1].text.splitlines()[0]}\n')
                self.restore(self.journal[:-1], 'undo')
        elif name == '%restart':
            self.restore(self.journal, 'restart')
        elif name == '%reset':
            self.restore([], 'reset')
        elif name == '%journal':
            for i, entry in enumerate(self.journal, 1):
                first, *rest = entry.text.split('\n')
                _write_out(f'{i:3} {first}\n' + ''.join(f'    {r}\n' for r in rest))
        elif name in ('%save', '%save-cpp'):
            if not arg:
                _write_out(f'usage: {name} FILE\n')
            else:
                path = Path(arg)
                if name == '%save':
                    path.write_text(''.join(e.text + '\n' for e in self.journal))
                else:
                    path.write_text(self.as_cpp(path))
                _write_out(f'saved {len(self.journal)} inputs to {path.resolve()}\n')
        elif name == '%load':
            if not arg or not Path(arg).is_file():
                _write_out('usage: %load FILE (a .cpp or a .repl)\n')
            else:
                return self.run_inputs(inputs_from_file(arg), echo=True) or not self.batch
        elif name == '%lib':
            line = f'%lib {arg}'
            output, result = self._send(line)
            if result == 'ok' and _ANY_ERROR.search(plain(output)):
                result = 'error'
            return self._after(text, [line], output, result, 'lib') or not self.batch
        else:
            _write_out(f'unknown command {name}; %help lists them\n')
        return True


