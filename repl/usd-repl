#!/usr/bin/env python3
"""usd-repl: an OpenUSD C++ REPL on top of clang-repl.

    repl/usd-repl                                     an empty session
    repl/usd-repl nvidia_tutorials/08_xform/main.cpp  run a lesson, keep the prompt
    repl/usd-repl --batch FILE...                     run files, exit 1 on any error
    repl/usd-repl --emit FILE...                      print the inputs a file becomes

clang-repl 18 runs the code; this script sits in front of it. It reads whole
blocks (brackets balanced, statements finished) and rewrites the shapes
clang-repl 18 gets wrong: top-level loops, ifs and try blocks run inside a
lambda. It prints bare expressions through repl/usd_repl.h. It keeps a journal
of the inputs that worked, so a crash, Ctrl-C or %undo rebuilds the session in
a fresh clang-repl. The README's REPL section has the details and the reasons.
"""

import argparse
import atexit
import json
import os
import re
import shlex
import shutil
import signal
import subprocess
import sys
from collections import namedtuple
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
PRELUDE = REPO / 'repl' / 'usd_repl.h'

# Loaded into every backend before the first input. Each library pulls in its
# own dependencies (sdf, tf, vt, gf, ...) through its RUNPATH.
LIBS = ['usd', 'usdGeom', 'usdShade', 'usdLux', 'usdSkel', 'usdPhysics', 'usdVol',
        'usdMedia', 'usdRender', 'usdUtils', 'usdUI', 'usdProc', 'usdSemantics', 'kind']

PROMPT, MORE = 'usd> ', '...> '

HELP = """\
Type C++ as you would inside main(). An input runs once its brackets balance
and its statement is finished. A multi-line if or try block runs after a blank
line, so that an else or catch can still follow.

A bare expression, with no semicolon, prints its value: a stage prints its usda,
a prim its type and children, an attribute its value.
  show(x)       print any value            tree(stage)   print the prim hierarchy

  %undo         drop the last input        %restart      rebuild from the journal
  %reset        start again, empty         %journal      list the inputs so far
  %save FILE    write the journal          %load FILE    run a lesson .cpp or a .repl
  %lib PATH     load a shared library      %quit         leave (or Ctrl-D)

Ctrl-C stops a running input and rebuilds the session without it, and so does a
crash. Names can't be redefined: use a new name, assign, or %undo.
"""

# ---------------------------------------------------------------------------
# Lexing and statement structure. Just enough C++ to find where inputs and
# statements end; comments are dropped.
# ---------------------------------------------------------------------------

_TOKEN = re.compile(r'''
    (?P<ws>\s+)
  | (?P<comment>//[^\n]*|/\*.*?\*/)
  | (?P<open_comment>/\*)
  | (?P<raw>(?:u8|[uUL])?R"(?P<delim>[^()\\\s"]{0,16})\(.*?\)(?P=delim)")
  | (?P<str>(?:u8|[uUL])?"(?:\\.|[^"\\\n])*"?)
  | (?P<chr>(?:u8|[uUL])?'(?:\\.|[^'\\\n])*'?)
  | (?P<ident>[A-Za-z_]\w*)
  | (?P<num>\.?\d(?:[eEpP][+-]|[\w.'])*)
  | (?P<op>::|->|\.\.\.|<<=|>>=|<=>|&&|\|\||<<|>>|\+\+|--|[-+*/%&|^!=<>]=|.)
''', re.X | re.S)
_KINDS = ('ws', 'comment', 'open_comment', 'raw', 'str', 'chr', 'ident', 'num', 'op')

Token = namedtuple('Token', 'kind text space')   # space: whitespace came before it

CONTROL = {'for', 'while', 'do', 'if', 'switch', 'try'}
# An input ending in one of these is not finished yet.
CONTINUES = {'=', ',', '<<', '&&', '||', '+', '-', '/', '%', '|', '^', '?', ':', '::',
             '->', '.', '<', '==', '!=', '<=', '>=', '+=', '-=', '*=', '/=', '%=',
             '&=', '|=', '^=', '<<=', '>>='}


def lex(text):
    """The significant tokens of text, and whether a /* comment is left open."""
    tokens, space, pos = [], False, 0
    while pos < len(text):
        m = _TOKEN.match(text, pos)
        kind = next(k for k in _KINDS if m.group(k) is not None)
        pos = m.end()
        if kind in ('ws', 'comment'):
            space = True
        elif kind == 'open_comment':
            return tokens, True
        else:
            tokens.append(Token(kind, m.group(kind), space))
            space = False
    return tokens, False


def _one_line(token):
    """A raw string spanning lines, rewritten as an ordinary literal: every
    input has to fit on one line."""
    if token.kind != 'raw' or '\n' not in token.text:
        return token.text
    m = re.fullmatch(r'(u8|[uUL])?R"([^(]*)\((.*)\)\2"', token.text, re.S)
    body = m.group(3).replace('\\', '\\\\').replace('"', '\\"').replace('\n', '\\n')
    return (m.group(1) or '') + '"' + body + '"'


def join(tokens):
    """Tokens back to one line of text, a single space where there was any."""
    return ''.join((' ' if t.space and i else '') + _one_line(t) for i, t in enumerate(tokens))


def _is(tokens, i, text, kind='op'):
    return i < len(tokens) and tokens[i].text == text and tokens[i].kind == kind


def _match(tokens, i):
    """Index of the bracket that closes the one at i (the last token if none does)."""
    depth = 0
    for j in range(i, len(tokens)):
        t = tokens[j]
        if t.kind == 'op' and t.text in '([{':
            depth += 1
        elif t.kind == 'op' and t.text in ')]}':
            depth -= 1
            if depth == 0:
                return j
    return len(tokens) - 1


def _plain_end(tokens, i):
    """End of a statement that is not control flow: its ';' at depth 0. A '}'
    closing a top-level block also ends it when control flow follows."""
    depth = 0
    for j in range(i, len(tokens)):
        t = tokens[j]
        if t.kind != 'op':
            continue
        if t.text in '([{':
            depth += 1
        elif t.text in ')]}':
            depth -= 1
            if depth == 0 and t.text == '}' and j + 1 < len(tokens):
                after = tokens[j + 1]
                if (after.kind == 'ident' and after.text in CONTROL) or _is(tokens, j + 1, '{'):
                    return j
        elif t.text == ';' and depth == 0:
            return j
    return len(tokens) - 1


def _stmt_end(tokens, i):
    """Index of the last token of the statement starting at i."""
    n = len(tokens)
    if i >= n:
        return n - 1
    t = tokens[i]
    if _is(tokens, i, '{'):
        return _match(tokens, i)
    if t.kind != 'ident' or t.text not in CONTROL:
        return _plain_end(tokens, i)
    j = i + 1
    if t.text in ('for', 'while', 'switch', 'if'):
        if t.text == 'if' and _is(tokens, j, 'constexpr', 'ident'):
            j += 1
        if _is(tokens, j, '('):
            j = _match(tokens, j) + 1
        if j >= n:
            return n - 1
        end = _stmt_end(tokens, j)
        if t.text == 'if' and _is(tokens, end + 1, 'else', 'ident'):
            return _stmt_end(tokens, end + 2) if end + 2 < n else n - 1
        return end
    if t.text == 'do':
        end = _stmt_end(tokens, j) if j < n else n - 1
        if _is(tokens, end + 1, 'while', 'ident'):
            k = end + 2
            if _is(tokens, k, '('):
                k = _match(tokens, k) + 1
            return k if _is(tokens, k, ';') else min(k, n) - 1
        return end
    # try
    if not _is(tokens, j, '{'):
        return _plain_end(tokens, i)
    end = _match(tokens, j)
    while _is(tokens, end + 1, 'catch', 'ident'):
        k = end + 2
        if _is(tokens, k, '('):
            k = _match(tokens, k) + 1
        if not _is(tokens, k, '{'):
            return n - 1
        end = _match(tokens, k)
    return end


def split_statements(tokens):
    """[(tokens, is_control_flow)] for each statement, in order."""
    out, i = [], 0
    while i < len(tokens):
        if _is(tokens, i, ';'):
            i += 1
            continue
        end = _stmt_end(tokens, i)
        first = tokens[i]
        control = _is(tokens, i, '{') or (first.kind == 'ident' and first.text in CONTROL)
        out.append((tokens[i:end + 1], control))
        i = end + 1
    return out


def _unsplice(text):
    """Join backslash-continued lines."""
    return re.sub(r'\\[ \t]*\n', ' ', text)


def completeness(text):
    """'complete', 'incomplete', or 'extendable': complete, but a multi-line
    if or try that an else or catch on the next line would still extend."""
    s = _unsplice(text).strip()
    if not s:
        return 'complete'
    if s.endswith('\\'):
        return 'incomplete'
    if s[0] in '#%' and '\n' not in s:
        return 'complete'
    tokens, open_comment = lex(s)
    if open_comment:
        return 'incomplete'
    if not tokens:
        return 'complete'
    depth = 0
    for t in tokens:
        if t.kind == 'op' and t.text in '([{':
            depth += 1
        elif t.kind == 'op' and t.text in ')]}':
            depth -= 1
    if depth > 0:
        return 'incomplete'
    last = tokens[-1]
    if (last.kind == 'op' and last.text in CONTINUES) or (last.kind == 'ident' and last.text in ('else', 'do')):
        return 'incomplete'
    stmts = split_statements(tokens)
    if not stmts:
        return 'complete'
    toks, control = stmts[-1]
    head = toks[0].text
    if control and toks[0].kind == 'ident':
        if not (last.kind == 'op' and last.text in (';', '}')):
            return 'incomplete'
        if head == 'do' and last.text != ';':
            return 'incomplete'
        if head == 'try' and not any(t.kind == 'ident' and t.text == 'catch' for t in toks):
            return 'incomplete'
        if head in ('if', 'try') and last.text == '}' and '\n' in s:
            return 'extendable'
    return 'complete'


def transform(text):
    """What to send to clang-repl for one input: (line, kind), kind being
    'pp', 'stmt', 'expr' or 'empty'. Control-flow statements are wrapped in a
    lambda, because clang-repl 18 mis-compiles them at top level."""
    s = _unsplice(text).strip()
    if s.startswith('#'):
        return ' '.join(s.split('\n')), 'pp'
    tokens, _ = lex(s)
    if not tokens:
        return '', 'empty'
    stmts = split_statements(tokens)
    if not stmts:
        return '', 'empty'
    parts = []
    for toks, control in stmts:
        line = join(toks)
        parts.append('[]{ %s }();' % line if control else line)
    line = ' '.join(parts)
    last = tokens[-1]
    if len(stmts) == 1 and not stmts[0][1] and not (last.kind == 'op' and last.text in (';', '}')):
        return line, 'expr'
    return line, 'stmt'


